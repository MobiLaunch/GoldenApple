# Golden Gate defaults for GNOME settings. Installed to
# /usr/share/glib-2.0/schemas by scripts/install.sh --system, then compiled.
# Users can still change every one of these.

[org.gnome.desktop.interface]
icon-theme='GoldenGate'
font-name='Inter Variable 10'
document-font-name='Inter Variable 10'
monospace-font-name='JetBrains Mono 10'
accent-color='blue'

[org.gnome.desktop.wm.preferences]
button-layout='close,minimize,maximize:'

# Finder's list view: compact rows, small icons, folders that expand in place.
[org.gnome.nautilus.list-view]
default-zoom-level='small'
use-tree-view=true

[org.gnome.nautilus.preferences]
show-create-link=true
