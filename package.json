{
  "name": "golden-gate",
  "private": true,
  "description": "Golden Gate: a Linux distribution with a Liquid Glass desktop.",
  "type": "module",
  "scripts": {
    "build": "node design/build.mjs && node icons/build.mjs",
    "dev": "npm run build && npx --yes http-server prototype -p 8080 -c-1",
    "icons:list": "node icons/build.mjs --list",
    "test:ui": "node prototype/tests/smoke.mjs",
    "screenshots": "node prototype/tests/screenshots.mjs",
    "test:shader": "node compositor/liquid-glass/test/render.mjs"
  },
  "devDependencies": {
    "pathkit-wasm": "^1.0.0",
    "playwright": "^1.56.1"
  }
}
