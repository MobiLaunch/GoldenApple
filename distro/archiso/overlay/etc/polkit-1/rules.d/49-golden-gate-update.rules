// Software Update is one click for administrators at the computer: the
// helper only refreshes and upgrades the installed packages (pacman -Syu)
// and Flatpak apps. Everything else still asks for a password.
polkit.addRule(function (action, subject) {
    if (action.id === "org.goldengate.update" && subject.local && subject.active
            && subject.isInGroup("wheel"))
        return polkit.Result.YES;
});
