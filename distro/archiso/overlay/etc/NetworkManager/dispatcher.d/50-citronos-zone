#!/bin/sh
# CitronOS: the firewall zone of a network, when its connection doesn't name
# one (`nmcli connection modify NAME connection.zone home|public` does, and
# always wins). Wired networks and Wi-Fi with a password (WPA/WPA3 Personal)
# are "home", where AirDrop and the AirPlay Receiver can be reached while
# they're on; open Wi-Fi, WPA Enterprise and everything else stay "public",
# where nothing can. Only the running firewall is changed, never the
# connection, so it's decided again each time the network comes up.
iface="$1"
action="$2"
[ "$action" = up ] || exit 0
[ -n "$iface" ] && [ -n "${CONNECTION_UUID:-}" ] || exit 0
command -v firewall-cmd >/dev/null 2>&1 || exit 0

setting() { nmcli -g "$1" connection show uuid "$CONNECTION_UUID" 2>/dev/null; }

[ -z "$(setting connection.zone)" ] || exit 0
case "$(setting connection.type)" in
  802-3-ethernet) zone=home ;;
  802-11-wireless)
    case "$(setting 802-11-wireless.mode)" in
      infrastructure|"")
        case "$(setting 802-11-wireless-security.key-mgmt)" in
          wpa-psk|sae) zone=home ;;
          *) zone=public ;;
        esac ;;
      *) zone=public ;;
    esac ;;
  *) zone=public ;;
esac
firewall-cmd --zone="$zone" --change-interface="$iface" >/dev/null 2>&1 || :
