# Who stops a process with SIGKILL, for the boot test only (gg.boottest on the
# kernel command line; it does nothing otherwise). The kernel's signal_generate
# tracepoint, kept to SIGKILL, names the sender and the process it was for;
# each line goes to the journal, which the boot test reads on the serial
# console (distro/archiso/boot-test.sh).
[Unit]
Description=CitronOS boot test: who sends SIGKILL
ConditionKernelCommandLine=gg.boottest
ConditionPathIsDirectory=/sys/kernel/tracing/events/signal/signal_generate
DefaultDependencies=no
After=sys-kernel-tracing.mount
Requires=sys-kernel-tracing.mount

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'echo "sig == 9" > /sys/kernel/tracing/events/signal/signal_generate/filter'
ExecStartPre=/bin/sh -c 'echo 1 > /sys/kernel/tracing/events/signal/signal_generate/enable'
ExecStart=/bin/cat /sys/kernel/tracing/trace_pipe
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gg-sigkill

[Install]
WantedBy=sysinit.target
