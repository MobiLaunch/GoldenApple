# Who stops a process with SIGKILL, for the boot test only (gg.boottest on the
# kernel command line; it does nothing otherwise). The kernel's signal_generate
# tracepoint, kept to SIGKILL and SIGXCPU (a CPU-time limit's warning), names
# the sender and the process it was for; with the kernel's own account of why
# (a resource limit's "Watchdog Timeout", with print_fatal_signals=1, or the
# out-of-memory killer), each line goes to the journal, which the boot test
# reads on the serial console (distro/archiso/boot-test.sh).
[Unit]
Description=CitronOS boot test: who sends SIGKILL
ConditionKernelCommandLine=gg.boottest
ConditionPathIsDirectory=/sys/kernel/tracing/events/signal/signal_generate
DefaultDependencies=no
After=sys-kernel-tracing.mount
Requires=sys-kernel-tracing.mount

[Service]
Type=simple
ExecStart=/usr/lib/golden-gate/boottest-watch.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gg-sigkill

[Install]
WantedBy=sysinit.target
