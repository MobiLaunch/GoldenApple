# Golden Gate additions on top of archiso's releng package list.
# Official Arch repositories only; see packages.extra for the rest.

# Compositor + session
hyprland
hypridle
hyprsunset
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk
polkit-gnome
gnome-keyring
libsecret
plymouth
sddm
qt6-declarative
qt6-svg
qt6-wayland
# Golden Gate Music and Photos: playback (FFmpeg backend), tags, artwork, video frames
qt6-multimedia
qt6-multimedia-ffmpeg
ffmpeg
# Golden Gate Photos: WebP, TIFF and other image formats
qt6-imageformats

# Look
inter-font
ttf-jetbrains-mono
noto-fonts
noto-fonts-emoji
adwaita-icon-theme
gsettings-desktop-schemas
librsvg

# Hardware firmware. The live image must boot on unknown machines, so keep the
# complete Arch firmware meta-package rather than relying on the build host.
linux-firmware
wireless-regdb

# Services the shell talks to
pipewire
pipewire-pulse
wireplumber
networkmanager
bluez
bluez-utils
brightnessctl
playerctl
upower
power-profiles-daemon
keyd
grim
slurp
wl-clipboard
libnotify
xdg-user-dirs

# External apps retained only where they provide mature system/protocol backends.
# Golden Gate owns Settings, App Store, Clock, TextEdit, Photos and other primary UI.
# App Store backend: native Golden Gate frontend + Flatpak/Flathub metadata.
flatpak
ca-certificates
curl
# Chromium engine and Python bindings for Golden Gate Web
qt6-webengine
pyside6
python
ghostty
sudo
arch-install-scripts
gptfdisk
parted
dosfstools
rsync
pacman-contrib

