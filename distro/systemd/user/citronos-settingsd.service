# CitronOS preferences on the session bus, org.citronos.Settings1
# (services/settingsd). D-Bus activation starts it the first time the shell or
# Settings asks (distro/dbus/org.citronos.Settings1.service).
[Unit]
Description=CitronOS preferences
PartOf=citronos-session.target

[Service]
Type=dbus
BusName=org.citronos.Settings1
ExecStart=/usr/bin/env gg-settingsd
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=citronos-settingsd
