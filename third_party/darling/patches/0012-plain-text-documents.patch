diff --git a/AppKit/NSPlainTextCoding.h b/AppKit/NSPlainTextCoding.h
new file mode 100644
index 0000000..fdeab4d
--- /dev/null
+++ b/AppKit/NSPlainTextCoding.h
@@ -0,0 +1,14 @@
+#import <Foundation/Foundation.h>
+
+// Plain-text document reading and writing for NSAttributedString.
+
+// Decodes data with the requested encoding (an NSNumber, or nil to detect
+// one). Detection honors a UTF-8 or UTF-16 byte order mark, then tries
+// UTF-8, then Windows Latin 1, then ISO Latin 1, which accepts any bytes.
+// Returns nil when the requested encoding cannot decode the data.
+NSString *_NSPlainTextDecode(NSData *data, NSNumber *encoding,
+                             NSStringEncoding *usedEncoding);
+
+// Encodes text without loss in the requested encoding (UTF-8 when nil).
+// Returns nil with NSFileWriteInapplicableStringEncodingError otherwise.
+NSData *_NSPlainTextEncode(NSString *text, NSNumber *encoding, NSError **error);
diff --git a/AppKit/NSPlainTextCoding.m b/AppKit/NSPlainTextCoding.m
new file mode 100644
index 0000000..770226d
--- /dev/null
+++ b/AppKit/NSPlainTextCoding.m
@@ -0,0 +1,55 @@
+#import "NSPlainTextCoding.h"
+
+static NSString *decode(NSData *data, NSStringEncoding encoding) {
+    return [[[NSString alloc] initWithData: data encoding: encoding] autorelease];
+}
+
+NSString *_NSPlainTextDecode(NSData *data, NSNumber *encoding,
+                             NSStringEncoding *usedEncoding)
+{
+    if (data == nil)
+        return nil;
+
+    NSStringEncoding chosen = NSUTF8StringEncoding;
+    NSString *text = nil;
+    const unsigned char *bytes = [data bytes];
+    NSUInteger length = [data length];
+
+    if (encoding != nil) {
+        chosen = [encoding unsignedIntegerValue];
+        text = decode(data, chosen);
+    } else if (length >= 3 && bytes[0] == 0xEF && bytes[1] == 0xBB && bytes[2] == 0xBF) {
+        chosen = NSUTF8StringEncoding;
+        text = decode([data subdataWithRange: NSMakeRange(3, length - 3)], chosen);
+    } else if (length >= 2 && ((bytes[0] == 0xFF && bytes[1] == 0xFE) ||
+                               (bytes[0] == 0xFE && bytes[1] == 0xFF))) {
+        chosen = NSUnicodeStringEncoding;
+        text = decode(data, chosen);
+    } else {
+        NSStringEncoding candidates[] = {NSUTF8StringEncoding, NSWindowsCP1252StringEncoding,
+                                         NSISOLatin1StringEncoding};
+        for (unsigned i = 0; text == nil && i < sizeof(candidates) / sizeof(candidates[0]); i++) {
+            chosen = candidates[i];
+            text = decode(data, chosen);
+        }
+    }
+
+    if (text != nil && usedEncoding != NULL)
+        *usedEncoding = chosen;
+    return text;
+}
+
+NSData *_NSPlainTextEncode(NSString *text, NSNumber *encoding, NSError **error) {
+    NSStringEncoding chosen = (encoding != nil) ? [encoding unsignedIntegerValue]
+                                                : NSUTF8StringEncoding;
+    NSData *data = [text dataUsingEncoding: chosen allowLossyConversion: NO];
+
+    if (data == nil && error != NULL) {
+        *error = [NSError errorWithDomain: NSCocoaErrorDomain
+                                     code: NSFileWriteInapplicableStringEncodingError
+                                 userInfo: [NSDictionary dictionaryWithObject:
+                                                   [NSNumber numberWithUnsignedInteger: chosen]
+                                                                       forKey: NSStringEncodingErrorKey]];
+    }
+    return data;
+}
