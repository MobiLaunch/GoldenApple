diff --git a/AppKit/NSDocumentTypes.h b/AppKit/NSDocumentTypes.h
new file mode 100644
index 0000000..2d77113
--- /dev/null
+++ b/AppKit/NSDocumentTypes.h
@@ -0,0 +1,24 @@
+#import <Foundation/Foundation.h>
+
+// Document types from CFBundleDocumentTypes. Since Mac OS X 10.5 a type is
+// either a CFBundleTypeName or, for entries with LSItemContentTypes, a UTI;
+// apps such as TextEdit use UTIs exclusively.
+typedef BOOL (*NSDocumentTypeConformance)(NSString *type, NSString *parent);
+
+// The declaration for a type: an exact name or UTI first, then the first
+// declared UTI the type conforms to (conforms may be NULL).
+NSDictionary *_NSDocumentTypeInfo(NSArray *fileTypes, NSString *type,
+                                  NSDocumentTypeConformance conforms);
+
+// The document type for a file's UTI: the UTI itself when its declaration
+// uses UTIs, else that declaration's name; nil when no declaration accepts it.
+NSString *_NSDocumentTypeForUTI(NSArray *fileTypes, NSString *uti,
+                                NSDocumentTypeConformance conforms);
+
+// The first Editor type, as a UTI when declared with LSItemContentTypes.
+NSString *_NSDocumentDefaultType(NSArray *fileTypes);
+
+// The types documentClass reads (Viewer or Editor) or writes (Editor only):
+// each declaration's UTIs, or its name when it declares none.
+NSArray *_NSDocumentTypesForClass(NSArray *fileTypes, Class documentClass,
+                                  BOOL editorsOnly);
diff --git a/AppKit/NSDocumentTypes.m b/AppKit/NSDocumentTypes.m
new file mode 100644
index 0000000..69ba25a
--- /dev/null
+++ b/AppKit/NSDocumentTypes.m
@@ -0,0 +1,82 @@
+#import "NSDocumentTypes.h"
+
+static NSArray *contentTypes(NSDictionary *info) {
+    id types = [info objectForKey: @"LSItemContentTypes"];
+    return [types isKindOfClass: [NSArray class]] ? types : nil;
+}
+
+static BOOL declaresType(NSDictionary *info, NSString *type) {
+    if ([type isEqualToString: [info objectForKey: @"CFBundleTypeName"]])
+        return YES;
+    // UTIs compare case-insensitively, like UTTypeEqual.
+    for (NSString *uti in contentTypes(info))
+        if ([uti caseInsensitiveCompare: type] == NSOrderedSame)
+            return YES;
+    return NO;
+}
+
+NSDictionary *_NSDocumentTypeInfo(NSArray *fileTypes, NSString *type,
+                                  NSDocumentTypeConformance conforms)
+{
+    if (type == nil)
+        return nil;
+    for (NSDictionary *info in fileTypes)
+        if (declaresType(info, type))
+            return info;
+    if (conforms == NULL)
+        return nil;
+    for (NSDictionary *info in fileTypes)
+        for (NSString *uti in contentTypes(info))
+            if (conforms(type, uti))
+                return info;
+    return nil;
+}
+
+NSString *_NSDocumentTypeForUTI(NSArray *fileTypes, NSString *uti,
+                                NSDocumentTypeConformance conforms)
+{
+    NSDictionary *info = _NSDocumentTypeInfo(fileTypes, uti, conforms);
+    if (info == nil)
+        return nil;
+    if ([contentTypes(info) count] > 0)
+        return uti;
+    return [info objectForKey: @"CFBundleTypeName"];
+}
+
+NSArray *_NSDocumentTypesForClass(NSArray *fileTypes, Class documentClass,
+                                  BOOL editorsOnly)
+{
+    NSMutableArray *result = [NSMutableArray array];
+    for (NSDictionary *info in fileTypes) {
+        NSString *role = [info objectForKey: @"CFBundleTypeRole"];
+        BOOL accepted = [role isEqualToString: @"Editor"] ||
+                        (!editorsOnly && [role isEqualToString: @"Viewer"]);
+        if (!accepted ||
+            NSClassFromString([info objectForKey: @"NSDocumentClass"]) != documentClass)
+            continue;
+        NSArray *utis = contentTypes(info);
+        NSString *name = [info objectForKey: @"CFBundleTypeName"];
+        for (NSString *type in ([utis count] > 0 ? utis : (name ? [NSArray arrayWithObject: name] : nil)))
+            if (![result containsObject: type])
+                [result addObject: type];
+    }
+    return result;
+}
+
+NSString *_NSDocumentDefaultType(NSArray *fileTypes) {
+    NSDictionary *chosen = nil;
+    for (NSDictionary *info in fileTypes) {
+        NSString *role = [info objectForKey: @"CFBundleTypeRole"];
+        if (role == nil || [role isEqualToString: @"Editor"]) {
+            chosen = info;
+            break;
+        }
+    }
+    if (chosen == nil && [fileTypes count] > 0)
+        chosen = [fileTypes objectAtIndex: 0];
+
+    NSArray *utis = contentTypes(chosen);
+    if ([utis count] > 0)
+        return [utis objectAtIndex: 0];
+    return [chosen objectForKey: @"CFBundleTypeName"];
+}
