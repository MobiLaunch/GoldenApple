+
+// Core system types normally declared by CoreTypes.bundle. Comparisons
+// ignore case, like UTTypeEqual; conformance is reflexive and transitive.
+const char* _UTCoreTypeForExtension(const char* extension);
+// NULL-terminated, preferred first; NULL when the type has no extension.
+const char* const* _UTCoreTypeExtensions(const char* identifier);
+int _UTCoreTypeIsDeclared(const char* identifier);
+int _UTCoreTypeConformsTo(const char* identifier, const char* parent);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
