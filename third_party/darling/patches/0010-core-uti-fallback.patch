+// Like macOS, a type conforms to itself and to every ancestor. The database
+// records only each declared type's direct parents, so follow them up to
+// core types, which the built-in table resolves.
+static Boolean conformsTo(CFStringRef inUTI, CFStringRef inConformsToUTI, int depth)
+{
+	char type[256], parent[256];
+	if (UTTypeEqual(inUTI, inConformsToUTI))
+		return TRUE;
+	if (_UTCoreTypeConformsTo(coreString(inUTI, type, sizeof(type)),
+			coreString(inConformsToUTI, parent, sizeof(parent))))
+		return TRUE;
+	if (depth > 16)
+		return FALSE;
+
+	CFArrayRef parents = UTTypeCopyParentIdentifiers(inUTI);
+	if (parents == NULL)
+		return FALSE;
+
+	Boolean retval = FALSE;
+	for (CFIndex i = 0; i < CFArrayGetCount(parents) && !retval; i++)
+		retval = conformsTo((CFStringRef) CFArrayGetValueAtIndex(parents, i), inConformsToUTI, depth + 1);
+	CFRelease(parents);
+	return retval;
+}
