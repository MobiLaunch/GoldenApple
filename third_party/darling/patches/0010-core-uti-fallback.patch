+
+// Core type identifiers and extensions are short ASCII strings; anything
+// that does not fit is not a core type.
+static const char* coreString(CFStringRef str, char* buffer, size_t size)
+{
+	if (str == NULL || !CFStringGetCString(str, buffer, size, kCFStringEncodingUTF8))
+		return NULL;
+	return buffer;
+}
+
+static CFArrayRef coreArray(const char* const* values)
+{
+	CFMutableArrayRef array = CFArrayCreateMutable(NULL, 0, &kCFTypeArrayCallBacks);
+	for (; *values != NULL; values++)
+	{
+		CFStringRef value = CFStringCreateWithCString(NULL, *values, kCFStringEncodingUTF8);
+		CFArrayAppendValue(array, value);
+		CFRelease(value);
+	}
+	return array;
+}
+
+// The core type for an extension when launchservicesd has no declaration.
+static CFArrayRef coreIdentifiersForTag(CFStringRef inTagClass, CFStringRef inTag, CFStringRef inConformingToUTI)
+{
+	char tag[256], parent[256];
+	if (inTagClass == NULL || !CFEqual(inTagClass, kUTTagClassFilenameExtension))
+		return NULL;
+	const char* identifier = _UTCoreTypeForExtension(coreString(inTag, tag, sizeof(tag)));
+	if (identifier == NULL)
+		return NULL;
+	if (inConformingToUTI != NULL &&
+		!_UTCoreTypeConformsTo(identifier, coreString(inConformingToUTI, parent, sizeof(parent))))
+		return NULL;
+	return coreArray((const char* const[]) { identifier, NULL });
+}
 
