+// macOS declares its core types in CoreTypes.bundle. Darling ships no such
+// bundle, so launchservicesd never records them and document-based apps
+// cannot resolve "public.plain-text" or ask whether it is "public.text".
+// This table answers for those types when the database has no record.
+
+#include "UTCoreTypesTable.h"
+#include <stddef.h>
+#include <strings.h>
+
+#define LIST(...) ((const char* const[]) { __VA_ARGS__, NULL })
+#define NONE ((const char* const[]) { NULL })
+
+struct core_type
+{
+	const char* identifier;
+	const char* const* conforms_to;
+	const char* const* extensions;
+};
+
+static const struct core_type core_types[] = {
+	{ "public.item", NONE, NONE },
+	{ "public.content", NONE, NONE },
+	{ "public.composite-content", LIST("public.content"), NONE },
+	{ "public.data", LIST("public.item"), NONE },
+	{ "public.directory", LIST("public.item"), NONE },
+	{ "public.folder", LIST("public.directory"), NONE },
+	{ "com.apple.package", LIST("public.directory"), NONE },
+	{ "public.text", LIST("public.data", "public.content"), NONE },
+	{ "public.plain-text", LIST("public.text"), LIST("txt", "text") },
+	{ "public.utf8-plain-text", LIST("public.plain-text"), NONE },
+	{ "public.utf16-plain-text", LIST("public.plain-text"), NONE },
+	{ "com.apple.traditional-mac-plain-text", LIST("public.text"), NONE },
+	{ "public.rtf", LIST("public.text"), LIST("rtf") },
+	{ "com.apple.rtfd", LIST("com.apple.package", "public.composite-content"), LIST("rtfd") },
+	{ "com.apple.flat-rtfd", LIST("public.data", "public.composite-content"), NONE },
+	{ "public.html", LIST("public.text"), LIST("html", "htm") },
+	{ "public.xml", LIST("public.text"), LIST("xml") },
+	{ "com.apple.webarchive", LIST("public.data", "public.composite-content"), LIST("webarchive") },
+	{ "public.source-code", LIST("public.plain-text"), NONE },
+	{ "public.zip-archive", LIST("public.data"), LIST("zip") },
+	{ "org.oasis-open.opendocument.text", LIST("public.zip-archive", "public.composite-content"), LIST("odt") },
+	{ "org.openxmlformats.wordprocessingml.document", LIST("public.zip-archive", "public.composite-content"), LIST("docx") },
+	{ "com.microsoft.word.doc", LIST("public.data", "public.composite-content"), LIST("doc") },
+	{ "com.microsoft.word.wordml", LIST("public.xml"), NONE },
+	{ "com.adobe.pdf", LIST("public.data", "public.composite-content"), LIST("pdf") },
+	{ "public.image", LIST("public.data", "public.content"), NONE },
+	{ "public.png", LIST("public.image"), LIST("png") },
+	{ "public.jpeg", LIST("public.image"), LIST("jpg", "jpeg") },
+	{ "public.tiff", LIST("public.image"), LIST("tif", "tiff") },
+};
+
+static const struct core_type* find_type(const char* identifier)
+{
+	if (identifier == NULL)
+		return NULL;
+	for (size_t i = 0; i < sizeof(core_types) / sizeof(core_types[0]); i++)
+	{
+		if (strcasecmp(core_types[i].identifier, identifier) == 0)
+			return &core_types[i];
+	}
+	return NULL;
+}
+
+const char* _UTCoreTypeForExtension(const char* extension)
+{
+	if (extension == NULL)
+		return NULL;
+	for (size_t i = 0; i < sizeof(core_types) / sizeof(core_types[0]); i++)
+	{
+		for (const char* const* ext = core_types[i].extensions; *ext != NULL; ext++)
+		{
+			if (strcasecmp(*ext, extension) == 0)
+				return core_types[i].identifier;
+		}
+	}
+	return NULL;
+}
+
+const char* const* _UTCoreTypeExtensions(const char* identifier)
+{
+	const struct core_type* type = find_type(identifier);
+	return (type != NULL && type->extensions[0] != NULL) ? type->extensions : NULL;
+}
+
+int _UTCoreTypeIsDeclared(const char* identifier)
+{
+	return find_type(identifier) != NULL;
+}
+
+static int conforms(const char* identifier, const char* parent, int depth)
+{
+	if (strcasecmp(identifier, parent) == 0)
+		return 1;
+	const struct core_type* type = find_type(identifier);
+	if (type == NULL || depth > 16)
+		return 0;
+	for (const char* const* next = type->conforms_to; *next != NULL; next++)
+	{
+		if (conforms(*next, parent, depth + 1))
+			return 1;
+	}
+	return 0;
+}
+
+int _UTCoreTypeConformsTo(const char* identifier, const char* parent)
+{
+	if (identifier == NULL || parent == NULL)
+		return 0;
+	return conforms(identifier, parent, 0);
+}
