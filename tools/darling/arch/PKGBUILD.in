# Generated by tools/darling/package-arch.py. Development package; GUI unverified.
pkgname=golden-gate-darling-experimental
pkgver=0.1.gg@LOCK_ID@
pkgrel=1
pkgdesc='Experimental pinned Darling runtime with Golden Gate AppKit and PIP changes'
arch=('x86_64')
url='https://github.com/MobiLaunch/GoldenApple'
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'fuse2' 'libcap' 'systemd-libs' 'cairo' 'fontconfig'
         'freetype2' 'libtiff' 'libxml2' 'libglvnd' 'mesa' 'glu' 'libbsd'
         'libxrandr' 'libxcursor' 'libxext' 'libxkbfile' 'libxkbcommon' 'giflib'
         'libpulse' 'ffmpeg' 'dbus' 'openssl' 'libelf' 'curl' 'libedit' 'icu')
makedepends=('git' 'git-lfs' 'python' 'cmake' 'ninja' 'clang' 'llvm' 'bison'
             'flex' 'pkgconf')
provides=('darling')
conflicts=('darling' 'darling-bin' 'darling-git')
# Preserve Mach-O binaries, upstream privilege modes and guest rootfs directories.
options=('!strip' '!debug' '!lto' '!buildflags' 'emptydirs')
source=('golden-gate-darling-source.tar.gz')
sha256sums=('@SOURCE_SHA256@')

build() {
    cd "$srcdir/golden-gate-darling"
    # Jobs stay conservative; the complete GUI build consumes substantial RAM.
    python tools/darling/build.py stage --source "$srcdir/darling" \
        --build "$srcdir/darling-build" --stage "$srcdir/darling-stage" \
        --install-prefix /usr --jobs 2
}

package() {
    cd "$srcdir/golden-gate-darling"
    cp -a "$srcdir/darling-stage/usr" "$pkgdir/" || return
    cp "$srcdir/darling-stage/golden-gate-darling-build.json" "$pkgdir/" || return
    python tools/darling/runtime.py "$pkgdir" --install-prefix /usr || return
    install -dm755 "$pkgdir/usr/share/golden-gate/darling" || return
    mv "$pkgdir/golden-gate-darling-build.json" \
        "$pkgdir/usr/share/golden-gate/darling/build.json" || return
    install -Dm644 "$srcdir/darling/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
