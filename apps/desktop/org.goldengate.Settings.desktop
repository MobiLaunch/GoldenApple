[Desktop Entry]
Type=Application
Name=System Settings
Comment=Wi-Fi, displays, appearance, the Dock and everything else about this computer
Icon=preferences-system
Exec=bash @APPS@/settings/open.sh
StartupWMClass=org.goldengate.Settings
Categories=Settings;System;
Keywords=preferences;settings;control;wifi;display;wallpaper;dock;sound;keyboard;
StartupNotify=false
