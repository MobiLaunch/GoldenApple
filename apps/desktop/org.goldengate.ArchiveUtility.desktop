[Desktop Entry]
Type=Application
Name=Archive Utility
GenericName=Archive Manager
Comment=Browse and safely extract ZIP and TAR archives
Icon=org.goldengate.ArchiveUtility
Exec=sh @APPS@/archive/open.sh %f
StartupWMClass=org.goldengate.ArchiveUtility
Categories=Utility;Archiving;FileTools;
Keywords=archive;zip;unzip;extract;compress;tar;gzip;
MimeType=application/zip;application/x-zip-compressed;application/x-cbz;application/x-tar;application/gzip;application/x-gzip;application/x-bzip-compressed-tar;application/x-xz-compressed-tar;application/x-gtar;application/x-compressed-tar;
StartupNotify=false
