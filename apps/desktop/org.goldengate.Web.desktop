[Desktop Entry]
Type=Application
Name=Web
GenericName=Web Browser
Comment=Browse the web with Golden Gate
Exec=sh "@APPS@/browser/launch.sh" %U
Icon=web-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=org.goldengate.Web
