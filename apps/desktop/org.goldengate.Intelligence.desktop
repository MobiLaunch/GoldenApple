[Desktop Entry]
Type=Application
Name=Citron Intelligence
Comment=Writing tools, questions, image generation and photo editing with Gemini
Icon=applications-graphics
Exec=sh @APPS@/intelligence/open.sh
StartupWMClass=org.goldengate.Intelligence
Categories=Utility;
Keywords=AI;Gemini;assistant;writing;rewrite;proofread;images;photos;
StartupNotify=false
Actions=Voice;Writing;Image;

[Desktop Action Writing]
Name=Writing Tools
Exec=sh @APPS@/intelligence/open.sh --writing

[Desktop Action Image]
Name=Create Image
Exec=sh @APPS@/intelligence/open.sh --image

[Desktop Action Voice]
Name=Talk to Citron
Exec=sh @APPS@/intelligence/open.sh --voice
