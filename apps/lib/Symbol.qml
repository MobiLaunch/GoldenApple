// A glyph from lib/assets/symbols (generated by icons/build.mjs, like the shell's).
//   tone: "auto" (dark on light, white on dark) | "white" | "accent" | "dark" | "gray"
import QtQuick
import "theme"

Image {
    id: root
    property string name
    property string tone: "auto"
    property real size: 17
    readonly property string resolved: tone === "auto" ? (Theme.dark ? "white" : "dark") : tone
    width: size; height: size
    source: name ? Qt.resolvedUrl("assets/symbols/" + name + (resolved === "white" ? "" : "@" + resolved) + ".svg") : ""
    sourceSize: Qt.size(size * 2, size * 2)
    smooth: true
}
