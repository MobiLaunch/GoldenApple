[Unit]
Description=Golden Gate native CitronPods engine initialization
Documentation=https://github.com/MobiLaunch/GoldenApple
After=basic.target
ConditionUser=!root

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/env gg-citronpods-bootstrap
TimeoutStartSec=300
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
