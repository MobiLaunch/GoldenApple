        "fieldBorder": "inset 0 0 0 0.5px rgba(0, 0, 0, 0.2), inset 0 0.5px 1px rgba(0, 0, 0, 0.05)",
        "segmentOn": "#ffffff", "segmentOnShadow": "0 1px 3px rgba(0, 0, 0, 0.14), 0 0 0 0.5px rgba(0, 0, 0, 0.05)",
        "switchOff": "rgba(120, 120, 128, 0.18)",
        "fillStrong": "rgba(0, 0, 0, 0.1)", "hover": "rgba(0, 0, 0, 0.035)", "altRow": "rgba(0, 0, 0, 0.028)",
        "separatorSoft": "rgba(0, 0, 0, 0.05)",
        "menu": "rgba(246, 246, 248, 0.94)", "tooltip": "rgba(246, 246, 248, 0.97)",
        "scrollbar": "rgba(0, 0, 0, 0.4)",
        "windowShadow": "0 0 0 0.5px rgba(0, 0, 0, 0.22), 0 28px 80px rgba(0, 0, 0, 0.30), 0 10px 24px rgba(0, 0, 0, 0.12)",
        "windowShadowInactive": "0 0 0 0.5px rgba(0, 0, 0, 0.16), 0 16px 44px rgba(0, 0, 0, 0.18), 0 4px 12px rgba(0, 0, 0, 0.08)",
        "trafficInactive": "#d4d4d4"
      },
      "dark": {
        "sidebar": "#2a2a2e",
        "sidebarShadow": "inset 0 0 0 0.5px rgba(255, 255, 255, 0.1), inset 0 1px rgba(255, 255, 255, 0.06)",
        "pill": "rgba(58, 58, 62, 0.92)", "pillHover": "rgba(70, 70, 74, 0.94)", "pillActive": "rgba(84, 84, 88, 0.95)",
