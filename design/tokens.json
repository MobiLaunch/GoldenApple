        "windowShadowInactive": "0 0 0 0.5px rgba(0, 0, 0, 0.8), inset 0 0 0 0.5px rgba(255, 255, 255, 0.1), 0 16px 44px rgba(0, 0, 0, 0.35), 0 4px 12px rgba(0, 0, 0, 0.18)",
        "trafficInactive": "#4a4a4d"
      }
    }
  },

  "material": {
    "_doc": "Liquid Glass. blur/saturation go to the compositor (backdrop), tint is painted on top, rim is the 1px specular edge, shine is the top-left light catch.",
    "glassClear": {
      "blur": 18, "saturate": 1.9, "brightness": 1.06,
      "tintLight": "rgba(255, 255, 255, 0.16)", "tintDark": "rgba(40, 60, 110, 0.18)",
      "rim": "rgba(255, 255, 255, 0.55)", "rimLow": "rgba(255, 255, 255, 0.12)",
      "shine": "rgba(255, 255, 255, 0.35)",
      "shadow": "0 10px 30px rgba(0, 20, 60, 0.18), 0 1px 3px rgba(0, 0, 0, 0.10)"
    },
    "glassRegular": {
      "blur": 30, "saturate": 1.8, "brightness": 1.0,
      "tintLight": "rgba(250, 250, 252, 0.62)", "tintDark": "rgba(36, 36, 40, 0.58)",
      "rim": "rgba(255, 255, 255, 0.70)", "rimLow": "rgba(255, 255, 255, 0.10)",
      "shine": "rgba(255, 255, 255, 0.45)",
      "shadow": "0 12px 40px rgba(0, 0, 0, 0.18), 0 2px 6px rgba(0, 0, 0, 0.08)"
    },
    "menu": {
      "blur": 40, "saturate": 1.8, "brightness": 1.0,
      "tintLight": "rgba(246, 246, 248, 0.74)", "tintDark": "rgba(40, 40, 44, 0.70)",
      "rim": "rgba(255, 255, 255, 0.75)", "rimLow": "rgba(255, 255, 255, 0.12)",
      "shine": "rgba(255, 255, 255, 0.4)",
      "shadow": "0 18px 50px rgba(0, 0, 0, 0.22), 0 0 0 0.5px rgba(0, 0, 0, 0.12)"
    }
  },

  "motion": {
    "_doc": "Springs are expressed like SwiftUI: response (seconds, the period of the undamped oscillation) and dampingFraction (1 = critically damped). build.mjs converts these to CSS linear() curves, QML SpringAnimation params and Hyprland beziers.",
    "spring": {
      "smooth":  { "response": 0.50, "dampingFraction": 1.00 },
      "snappy":  { "response": 0.40, "dampingFraction": 0.86 },
      "bouncy":  { "response": 0.50, "dampingFraction": 0.70 },
      "popover": { "response": 0.38, "dampingFraction": 0.78 },
      "dock":    { "response": 0.22, "dampingFraction": 0.90 },
      "window":  { "response": 0.45, "dampingFraction": 0.88 }
    },
    "duration": { "hover": 120, "fade": 180, "menu": 160, "minimize": 520 }
  }
}
