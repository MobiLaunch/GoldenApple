{
  "name": "Golden Gate",
  "version": "0.1.0",

  "font": {
    "family": {
      "ui": "Inter Variable, Inter, system-ui, sans-serif",
      "display": "Inter Display, Inter Variable, Inter, system-ui, sans-serif",
      "mono": "JetBrains Mono, ui-monospace, monospace"
    },
    "features": "\"cv05\", \"cv08\", \"ss03\", \"tnum\" 0",
    "size": {
      "caption2": 10,
      "caption": 11,
      "footnote": 12,
      "body": 13,
      "callout": 14,
      "headline": 13,
      "title3": 15,
      "title2": 17,
      "title1": 22,
      "largeTitle": 26
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "tracking": { "caption": 0.01, "body": -0.005, "title": -0.018 }
  },

  "radius": {
    "control": 6,
    "menuItem": 8,
    "menu": 14,
    "field": 18,
    "capsule": 999,
    "tile": 26,
    "window": 22,
    "sidebar": 16,
    "dock": 26,
    "appIcon": 0.2237
  },

  "spacing": { "xxs": 2, "xs": 4, "s": 6, "m": 10, "l": 14, "xl": 20, "xxl": 28 },

  "size": {
    "menubar": 30,
    "toolbar": 52,
