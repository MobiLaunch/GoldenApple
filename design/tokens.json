        "buttonShadow": "inset 0 0.5px rgba(255, 255, 255, 0.1)",
        "control": "rgba(255, 255, 255, 0.1)",
        "controlBorder": "inset 0 0 0 0.5px rgba(255, 255, 255, 0.18)",
        "fieldBorder": "inset 0 0 0 0.5px rgba(255, 255, 255, 0.14)",
        "segmentOn": "#5a5a5e", "segmentOnShadow": "0 1px 2px rgba(0, 0, 0, 0.3)",
        "switchOff": "rgba(120, 120, 128, 0.32)",
        "fillStrong": "rgba(255, 255, 255, 0.14)", "hover": "rgba(255, 255, 255, 0.04)", "altRow": "rgba(255, 255, 255, 0.035)",
