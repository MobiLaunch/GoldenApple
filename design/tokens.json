{
  "name": "Golden Gate",
  "version": "0.1.0",

  "font": {
    "family": {
      "ui": "Inter Variable, Inter, system-ui, sans-serif",
      "display": "Inter Display, Inter Variable, Inter, system-ui, sans-serif",
      "mono": "JetBrains Mono, ui-monospace, monospace"
    },
    "features": "\"cv05\", \"cv08\", \"ss03\", \"tnum\" 0",
    "size": {
      "caption2": 10,
      "caption": 11,
      "footnote": 12,
      "body": 13,
      "callout": 14,
      "headline": 13,
      "title3": 15,
      "title2": 17,
      "title1": 22,
      "largeTitle": 26
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "tracking": { "caption": 0.01, "body": -0.005, "title": -0.018 }
  },

  "radius": {
    "control": 6,
    "menuItem": 8,
    "menu": 14,
    "field": 18,
    "capsule": 999,
    "tile": 26,
    "window": 22,
    "sidebar": 16,
    "dock": 26,
    "appIcon": 0.2237
  },

  "spacing": { "xxs": 2, "xs": 4, "s": 6, "m": 10, "l": 14, "xl": 20, "xxl": 28 },

  "size": {
    "menubar": 30,
    "toolbar": 52,
    "toolbarPill": 36,
    "trafficLight": 13,
    "sidebar": 220,
    "dockIcon": 54,
    "dockMagnified": 86,
    "ccModule": 64,
    "ccWidth": 300
  },

  "color": {
    "accent": { "blue": "#0a84ff", "purple": "#bf5af2", "pink": "#ff375f", "red": "#ff453a", "orange": "#ff9f0a", "yellow": "#ffd60a", "green": "#30d158", "graphite": "#8e8e93" },
    "trafficLight": { "close": "#ff5f57", "minimize": "#febc2e", "zoom": "#28c840", "inactive": "#d4d4d4" },
    "light": {
      "windowBg": "#ffffff",
      "contentBg": "#ffffff",
      "sidebarBg": "rgba(246, 246, 248, 0.72)",
      "label": "rgba(0, 0, 0, 0.88)",
      "secondaryLabel": "rgba(0, 0, 0, 0.55)",
      "tertiaryLabel": "rgba(0, 0, 0, 0.28)",
      "separator": "rgba(0, 0, 0, 0.09)",
      "fill": "rgba(0, 0, 0, 0.05)",
      "selection": "rgba(0, 0, 0, 0.07)",
      "menuHighlight": "rgba(0, 0, 0, 0.06)"
    },
    "dark": {
      "windowBg": "#1e1e1e",
      "contentBg": "#1a1a1a",
      "sidebarBg": "rgba(46, 44, 52, 0.62)",
      "label": "rgba(255, 255, 255, 0.92)",
      "secondaryLabel": "rgba(255, 255, 255, 0.55)",
      "tertiaryLabel": "rgba(255, 255, 255, 0.25)",
      "separator": "rgba(255, 255, 255, 0.10)",
      "fill": "rgba(255, 255, 255, 0.07)",
      "selection": "rgba(255, 255, 255, 0.10)",
      "menuHighlight": "rgba(255, 255, 255, 0.10)"
    }
  },

  "material": {
    "_doc": "Liquid Glass. blur/saturation go to the compositor (backdrop), tint is painted on top, rim is the 1px specular edge, shine is the top-left light catch.",
    "glassClear": {
      "blur": 18, "saturate": 1.9, "brightness": 1.06,
      "tintLight": "rgba(255, 255, 255, 0.16)", "tintDark": "rgba(40, 60, 110, 0.18)",
      "rim": "rgba(255, 255, 255, 0.55)", "rimLow": "rgba(255, 255, 255, 0.12)",
      "shine": "rgba(255, 255, 255, 0.35)",
      "shadow": "0 10px 30px rgba(0, 20, 60, 0.18), 0 1px 3px rgba(0, 0, 0, 0.10)"
    },
    "glassRegular": {
      "blur": 30, "saturate": 1.8, "brightness": 1.0,
      "tintLight": "rgba(250, 250, 252, 0.62)", "tintDark": "rgba(36, 36, 40, 0.58)",
      "rim": "rgba(255, 255, 255, 0.70)", "rimLow": "rgba(255, 255, 255, 0.10)",
      "shine": "rgba(255, 255, 255, 0.45)",
      "shadow": "0 12px 40px rgba(0, 0, 0, 0.18), 0 2px 6px rgba(0, 0, 0, 0.08)"
    },
    "menu": {
      "blur": 40, "saturate": 1.8, "brightness": 1.0,
      "tintLight": "rgba(246, 246, 248, 0.74)", "tintDark": "rgba(40, 40, 44, 0.70)",
      "rim": "rgba(255, 255, 255, 0.75)", "rimLow": "rgba(255, 255, 255, 0.12)",
      "shine": "rgba(255, 255, 255, 0.4)",
      "shadow": "0 18px 50px rgba(0, 0, 0, 0.22), 0 0 0 0.5px rgba(0, 0, 0, 0.12)"
    }
  },

  "motion": {
    "_doc": "Springs are expressed like SwiftUI: response (seconds, the period of the undamped oscillation) and dampingFraction (1 = critically damped). build.mjs converts these to CSS linear() curves, QML SpringAnimation params and Hyprland beziers.",
    "spring": {
      "smooth":  { "response": 0.50, "dampingFraction": 1.00 },
      "snappy":  { "response": 0.40, "dampingFraction": 0.86 },
      "bouncy":  { "response": 0.50, "dampingFraction": 0.70 },
      "popover": { "response": 0.38, "dampingFraction": 0.78 },
      "dock":    { "response": 0.22, "dampingFraction": 0.90 },
      "window":  { "response": 0.45, "dampingFraction": 0.88 }
    },
    "duration": { "hover": 120, "fade": 180, "menu": 160, "minimize": 520 }
  }
}
