      "selection": "rgba(255, 255, 255, 0.10)",
      "menuHighlight": "rgba(255, 255, 255, 0.10)"
    },
    "system": {
      "_doc": "Apple's system colours per appearance. The GTK theme maps libadwaita's accent palette onto them, so the accent the user picks comes out in these tones.",
      "light": { "blue": "#007aff", "teal": "#30b0c7", "green": "#28cd41", "yellow": "#ffcc00", "orange": "#ff9500", "red": "#ff3b30", "pink": "#ff2d55", "purple": "#af52de", "slate": "#8e8e93" },
      "dark":  { "blue": "#0a84ff", "teal": "#40c8e0", "green": "#32d74b", "yellow": "#ffd60a", "orange": "#ff9f0a", "red": "#ff453a", "pink": "#ff375f", "purple": "#bf5af2", "slate": "#98989d" }
    },
    "gtk": {
      "_doc": "Surfaces for the GTK theme (design/gtk/theme.css). GTK can't blur, so glass is drawn as tints plus the prototype's shadows.",
      "light": {
        "sidebar": "#efeff2",
        "sidebarShadow": "inset 0 0 0 0.5px rgba(0, 0, 0, 0.07), 0 1px 5px rgba(0, 0, 0, 0.05)",
        "pill": "rgba(255, 255, 255, 0.92)", "pillHover": "#f3f3f5", "pillActive": "#e7e7ea",
        "pillShadow": "0 1px 2px rgba(0, 0, 0, 0.05), 0 3px 12px rgba(0, 0, 0, 0.08), 0 0 0 0.5px rgba(0, 0, 0, 0.07)",
        "button": "rgba(0, 0, 0, 0.05)", "buttonHover": "rgba(0, 0, 0, 0.07)", "buttonActive": "rgba(0, 0, 0, 0.11)",
        "buttonShadow": "inset 0 0 0 0.5px rgba(0, 0, 0, 0.09)",
